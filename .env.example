# Copy to .env. docker compose overrides the infrastructure URLs for containers.

ENVIRONMENT=development

# --- Models: "<provider>:<model>", provider = anthropic | openai | azure (model = deployment name)
SMALL_MODEL=anthropic:claude-haiku-5-5
FRONTIER_MODEL=anthropic:claude-opus-5-5
# CLASSIFIER_MODEL=anthropic:claude-haiku-5-5   # defaults to SMALL_MODEL
# JUDGE_MODEL=anthropic:claude-opus-5-5         # eval judge, defaults to FRONTIER_MODEL
SMALL_EFFORT=low
FRONTIER_EFFORT=high
# Example: all-Azure deployment (leave *_EFFORT empty for models without reasoning_effort)
# SMALL_MODEL=azure:<small-deployment>
# FRONTIER_MODEL=azure:<frontier-deployment>
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=

# --- Embeddings (Anthropic has no embeddings endpoint): openai:<model> | azure:<deployment> | hashing
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIM=1536

# --- Infrastructure (local, outside docker)
DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant
REDIS_URL=redis://localhost:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Identity: oidc (Keycloak in compose) or dev (HS256 tokens from `make token`)
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8080/realms/company
OIDC_AUDIENCE=assistant-api
OIDC_ROLES_CLAIM=realm_access.roles
DEV_JWT_SECRET=dev-only-insecure-secret-change-me
MCP_TOKEN_MODE=forward
# MCP_TOKEN_MODE=exchange needs:
# OIDC_TOKEN_URL=http://keycloak:8080/realms/company/protocol/openid-connect/token
# OIDC_CLIENT_ID=assistant-api
# OIDC_CLIENT_SECRET=dev-assistant-api-secret

CANARY_SEED=change-me-canary-seed

# --- Integrations (read by the MCP server containers only)
JIRA_BACKEND=demo
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=IT
SLACK_BACKEND=demo
# SLACK_BOT_TOKEN=xoxb-...
SLACK_ALLOWED_CHANNELS=#it-helpdesk,#hr-questions,#general
